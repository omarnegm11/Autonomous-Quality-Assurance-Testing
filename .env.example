# Local PostgreSQL, dedicated synthetic test deployment only.
TEST_DATABASE_URL=postgresql+psycopg://qa_app:CHANGE_ME@127.0.0.1:55432/qa_app_test
AGENT_STATE_DATABASE_URL=postgresql+psycopg://qa_state:CHANGE_ME@127.0.0.1:55432/qa_agent_state
# Separate SELECT-only role; never give agents arbitrary SQL.
VERIFIER_DATABASE_URL=postgresql+psycopg://qa_verifier:CHANGE_ME@127.0.0.1:55432/qa_app_test
TEST_USER_A_PASSWORD=CHANGE_ME
TEST_USER_B_PASSWORD=CHANGE_ME
# Groq's native LangChain adapter; only a Groq key is needed.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Native Groq SDK root (or leave blank to use its default).
LLM_BASE_URL=https://api.groq.com
# Qwen instruct mode. Clear this when switching to a model that does not support it.
LLM_REASONING_EFFORT=none
LLM_RATE_LIMIT_RETRIES=3
LLM_MAX_RETRY_WAIT_SECONDS=60
APP_URL=http://127.0.0.1:8000
APP_SOURCE=.local/builds/clean
RUNS_DIR=runs
BROWSERS_PATH=.local/browsers
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=120
BROWSER_TYPE_DELAY_MS=20
BROWSER_MAX_RESTARTS=2
SPECIALIST_ACTIONS_PER_ACTIVATION=1
RANDOM_SEED=7
MAX_ACTIONS=60
# Allow time for Groq free-tier waits, with a separate token ceiling.
MAX_SECONDS=600
MAX_MODEL_TOKENS=60000
# Local evidence is always enabled. External tracing is deliberately off.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Optional dashboard/runner defaults. Blank API URLs use APP_URL.
API_URL=
API_SPEC_URL=
API_AUTH_HEADER=Authorization
API_AUTH_VALUE=
WORKFLOW=task_lifecycle
REQUIREMENTS=
